
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- 管理者判定 ---
    //
    // 判定材料は Custom Claim (request.auth.token.admin) のみ。
    // Claim は Admin SDK からしか付与できずクライアントからは書き換え不能なため、
    // Firestore 側が書き換えられても昇格されない。ドキュメント読み取りも発生しない。
    // 付与・剥奪は Cloud Functions の setUserRole（Admin SDK）で行う。
    //
    // 2026-08-21: 全管理者への Claim 付与が完了したため、移行期間中の
    // users/{uid}.role == 'admin' フォールバックを削除した。
    // setUserRole は今も role フィールドを書き続けるが、それは管理画面の表示用で
    // あって認可の判断材料ではない（＝role が書き換えられても昇格に繋がらない）。
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // User Profiles: 本人のみ読み書き可。管理者は全件読み取り可。
    //
    // role は本人から書き換え不能にすること。以前は `allow write` 一本で
    // フィールド制限が無かったため、任意のログインユーザーが自分のドキュメントに
    // role:'admin' を書き込むだけで管理者に昇格できた（当時は3層すべての管理者判定が
    // このフィールドを参照していたため、実質フルアクセスを取得できた）。
    // 現在は認可が Custom Claim のみに移ったため二重の防御になっている。
    //
    // 昇格・降格は Cloud Functions の setUserRole 経由のみ（Admin SDK は
    // ルールを迂回するため、ここで管理者に write を許可する必要はない）。
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // 新規登録時。role は 'user' 固定。
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user';

      // プロフィール更新時。role は現在値から変更できない。
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == resource.data.get('role', 'user');

      // 退会は Auth ユーザーとの整合が必要なため Cloud Functions 経由。
      allow delete: if false;
    }

    // Devices: Public read access for the catalog. Admins can write.
    match /devices/{deviceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null && (
          // 1. User locks an available device to start application
          (resource.data.status == 'available' && request.resource.data.status == 'processing' && request.resource.data.currentUserId == request.auth.uid) ||
          // 2. User releases a processing device (timeout or back button)
          (resource.data.status == 'processing' && resource.data.currentUserId == request.auth.uid && request.resource.data.status == 'available') ||
          // 3. User completes payment and activates device
          (resource.data.status == 'processing' && resource.data.currentUserId == request.auth.uid && request.resource.data.status == 'active') ||
          // 4. User submits an application: the device the user already holds moves to admin review.
          //    Only the lock holder can do this, and only from 'processing'.
          //    'under_review' -> * は管理者のみ（審査中の機器を利用者が勝手に戻せない）。
          (resource.data.status == 'processing' && resource.data.currentUserId == request.auth.uid && request.resource.data.status == 'under_review')
        )
      );
    }

    // Device Type Codes: Public read access. Admins can manage.
    match /deviceTypeCodes/{codeId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // News: Public read access for published news. Admins can write.
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Applications: Users can read and write only their own applications. Admins can do everything.
    //
    // 【金額改ざん防止】payAmount などの金額系フィールドは、申込作成後は本人から
    // 変更できない。作成時にブラウザが入れた金額は Cloud Functions
    // (onApplicationCreate) がサーバー再計算値で上書きし、その根拠を `pricing`
    // スナップショットとして刻む。決済時 (createStripePayment) はこの値と照合する。
    // Admin SDK はルールを迂回するため、サーバー側の正規化はここで禁止しても動く。
    //
    // 本人が正当に更新するのは status / 本人確認書類 / 同意書のみ（マイページ）。
    match /applications/{applicationId} {
      // サーバーだけが書いてよい金額・契約条件フィールド
      function lockedPricingFields() {
        return [
          'payAmount', 'originalAmount', 'couponDiscount', 'couponId', 'couponCode',
          'pricing', 'deviceId', 'deviceSerialNumber', 'payType', 'rentalType',
          'rentalPeriod', 'isRenewal', 'previousSubscriptionId', 'previousEndAt',
          'paymentMethod', 'bankTransfer', 'paymentLinkId', 'userId'
        ];
      }

      // 本人のみ作成可。新規作成時のステータスは 'pending' 固定（審査前の段階を飛ばした直接作成を防ぐ軽い検証）。
      // 重複申請の制御はクライアント側の保存時ガードで行う（ステータス連動で自己回復するためロック方式は使わない）。
      // `pricing` はサーバーの署名代わりなので、作成時にクライアントから持ち込めない。
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('pricing' in request.resource.data);
      allow read: if request.auth != null && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.userId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedPricingFields()));
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Subscriptions: Users can read their own and create their own (決済完了時). Admins manage all.
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Support Requests (修理・サポート依頼): Users can read/create their own.
    // Admins triage them from /admin/support-requests.
    //
    // 新規は 'open' 固定。対応状況（in_progress / resolved など）と社内向けの
    // adminNote は管理者だけが書き換えられるため、利用者が自分の依頼を
    // 完了済みに見せかけたり、未対応キューから消したりはできない。
    match /supportRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if request.auth != null && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    // Coupons: Admin read/write. Users read-only if active.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email Templates: Admin only.
    match /emailTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Email Triggers: Admin only.
    match /emailTriggers/{triggerId} {
      allow read, write: if isAdmin();
    }

    // Mail Accounts: Admin reads list of senders. All writes go through Cloud Functions
    // (createSmtpAccount / gmailOAuthCallback / setDefaultMailAccount / etc).
    match /mail_accounts/{accountId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Mail Gmail tokens / SMTP credentials / OAuth state: Cloud Function only.
    match /mail_gmail_tokens/{accountId} {
      allow read, write: if false;
    }
    match /mail_smtp_credentials/{accountId} {
      allow read, write: if false;
    }
    match /oauth_states/{state} {
      allow read, write: if false;
    }

    // Device Modules: Public read for product details. Admins manage.
    match /deviceModules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Modules: Public read for product details. Admins manage.
    match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Waitlist: Users can create their own.
    match /waitlist/{waitlistId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Payment Links: Public read. 決済完了時に認証ユーザーがstatusを'used'へ変更可能. Adminsは全操作可能.
    //
    // 【金額改ざん防止】一般ユーザーに許すのは status を 'used' にする操作だけ。
    // 以前はフィールド制限が無かったため、status を pending→used にする同じ更新で
    // payAmount も一緒に書き換えられた（＝請求額の改ざんが可能だった）。
    match /paymentLinks/{linkId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.status == 'pending'
            && request.resource.data.status == 'used'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
    }

    // Global Settings: Admins can write. Public read (contains non-sensitive config like service name, model settings).
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Consent Form: Public read (terms are public-facing). Admins can write.
    match /consentForm/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // QA Knowledge Base: Public read (server actions / AI chatbot read without
    // auth context). Admins manage. Categories and items are separate collections.
    match /qaCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /qaItems/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials: Public read. Admins manage.
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQs: Public read. Admins manage.
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Case Studies: Public read. Admins manage.
    match /caseStudies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Early Bookings (先行予約): Anyone can create; only admins can read/update/delete.
    match /earlyBookings/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
